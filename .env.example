# ==================================================================================
# Copy this file to `.env` and fill in real values for LOCAL DEVELOPMENT ONLY.
# NEVER commit `.env` — it is already excluded via .gitignore.
# In CI/CD, the same variable names are injected from GitHub Secrets /
# Azure DevOps variable groups instead of this file. See README.md.
# ==================================================================================

# ---- dbt target (dev | staging | prod) ----
DBT_TARGET=dev

# ---- Snowflake connection ----
SNOWFLAKE_ACCOUNT=ex52281.east-us.azure
SNOWFLAKE_USER=TF_CICD_SVC
SNOWFLAKE_ROLE=TF_CICD_ROLE
SNOWFLAKE_WAREHOUSE=COMPUTE_WH

# Use ONE of the two private key options below (never both committed to git):
# 1) Raw key contents (recommended for CI — key is injected from a secret)
SNOWFLAKE_PRIVATE_KEY=
# 2) Path to a local key file on your machine (recommended for local dev)
SNOWFLAKE_PRIVATE_KEY_PATH=/absolute/path/to/rsa_key.p8
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=

# ---- dbt database routing (per environment / medallion layer) ----
DBT_LANDING_DB=DEV_HC_LANDING
DBT_RAW_DB=DEV_HC_RAW
DBT_FUSION_DB=DEV_HC_FUSION
DBT_CONSUMPTION_DB=DEV_HC_CONSUMPTION
DBT_DEFAULT_SCHEMA=HCHB
DBT_THREADS=4

# ---- Terraform (mirrors the Snowflake vars above via TF_VAR_ prefix) ----
TF_VAR_snowflake_org=your_org_name
TF_VAR_snowflake_account=ex52281.east-us.azure
TF_VAR_snowflake_user=TF_CICD_SVC
TF_VAR_user_private_key=/absolute/path/to/rsa_key.p8
TF_VAR_private_key_passphrase=
TF_VAR_warehouse=COMPUTE_WH
TF_VAR_role=TF_CICD_ROLE
TF_VAR_database=HC_LANDING
TF_VAR_schema=HCHB
TF_VAR_environment=DEV
